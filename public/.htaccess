# ON Agência - proteções para Apache 2.4 / Hostinger
# Manter manifests JSON de public/models/face-api ACESSÍVEIS, pois são públicos e usados pelo frontend.
DirectoryIndex index.html
Options -MultiViews -Indexes
RewriteEngine On
RewriteBase /

# Bloquear acesso externo a arquivos privados de configuração, sessões, banco e logs.
# Esses arquivos ainda podem ser lidos internamente pelos scripts PHP via sistema de arquivos.
<FilesMatch "(?i)(^\.env($|\.)|^\.git|(?:_config|_db|_log|_cache)\.json$|\.(?:db|sqlite|sqlite3)(?:-.*)?$|\.(?:bak|backup|old|orig|swp|sql|pem|p12|pfx|key)$|^whatsapp_qrcode\.png$)">
    Require all denied
</FilesMatch>

# Impedir execução de scripts em áreas destinadas a conteúdo estático.
# Atenção: preservar endpoints PHP legítimos na raiz.
RewriteRule ^(?:images|videos|models|js)/.*\.(?:php|phtml|phar)$ - [F,L,NC]

# Servir arquivos estáticos existentes diretamente
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Se for diretório com index.html, servir o index.html
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ $1/index.html [L]

# Fallback para rotas sem extensão (.html)
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# Evitar cache de arquivos HTML para que atualizações entrem imediatamente no navegador
<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
